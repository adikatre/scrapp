# Detection provider (server-side only)
DETECTION_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
# Keep the current evaluation baseline unless a model change passes the evaluation gate.
OPENAI_MODEL=gpt-4o-mini

# Google Maps / Places
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Upstash Redis for production rate limiting
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# Optional privacy-filtered product analytics and error reporting
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_SENTRY_DSN=

NEXT_PUBLIC_DISABLE_CAMERA=false
