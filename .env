# Google Maps / Places (required for /locations page)

# Server-side: Places API Text Search + Place Details (keep secret)
# Enable "Places API (New)" in Google Cloud Console
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Client-side: Maps JavaScript API for interactive map tiles
# RESTRICT THIS KEY in Google Cloud Console -> APIs & Services -> Credentials
# Application restrictions: HTTP referrers -> add your domain (e.g., https://scrapp.app/*)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Backend URL (Railway/Render/Fly.io)
# Must point to your Flask backend's /predict endpoint
NEXT_PRIVATE_BACKEND_URL=https://localhost:3000

# Shared secret sent to the backend as `Authorization: Bearer ***`
# Must match BACKEND_API_KEY on the Railway backend exactly.
BACKEND_API_KEY=your_backend_api_key_here

# Upstash Redis for rate limiting (recommended for production)
# Get from https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# PostHog Analytics (optional - free tier: 1M events/mo)
# Get from https://app.posthog.com/project/settings
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_p35DqwXX6rLSC3CJpCwsBrw9oZDFfAq3BJutdwc7rz6N
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_KEY=phc_your_posthog_key_here

# Sentry Error Tracking (optional - free tier: 5K errors/mo)
# Get from https://sentry.io/settings/projects/your-project/keys/
SENTRY_DSN=https://your_dsn@o123456.ingest.sentry.io/123456
NEXT_PUBLIC_SENTRY_DSN=https://your_dsn@o123456.ingest.sentry.io/123456
SENTRY_AUTH_TOKEN=your_sentry_auth_token_here

# Feature flags
# Set to 'true' to disable camera functionality (emergency kill switch)
NEXT_PUBLIC_DISABLE_CAMERA=false